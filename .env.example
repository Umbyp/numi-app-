EXPO_PUBLIC_WORKER_URL=https://numi-worker.<your-subdomain>.workers.dev
EXPO_PUBLIC_APP_TOKEN=<same APP_TOKEN you set with `wrangler secret put APP_TOKEN`>

# ไม่ตั้งก็ได้ (dev) — Sentry จะปิดตัวเองอัตโนมัติถ้าไม่มีค่านี้ (ดู lib/sentry.ts)
# เอาจาก sentry.io -> Settings -> Projects -> <project> -> Client Keys (DSN)
EXPO_PUBLIC_SENTRY_DSN=

# ต้องมีเสมอจนกว่าจะตั้ง SENTRY_ORG/SENTRY_PROJECT จริง ไม่งั้น native build จะพัง
# ("An organization ID or slug is required") เพราะ config plugin เพิ่ม build phase
# อัปโหลด source map ให้อัตโนมัติ ตั้ง org/project จริงแล้วค่อยลบบรรทัดนี้ออก
SENTRY_DISABLE_AUTO_UPLOAD=true
